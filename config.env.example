# X Account (twscrape)
X_ACCOUNT_USERNAME=your_x_username
X_ACCOUNT_PASSWORD=your_x_password
X_ACCOUNT_EMAIL=your_email@gmail.com
X_ACCOUNT_EMAIL_PASSWORD=your_email_password

# Discord
DISCORD_WEBHOOK_SERENITY=https://discord.com/api/webhooks/...

# Paths (optional, defaults to ~/scraper)
SCRAPER_DIR=~/scraper
